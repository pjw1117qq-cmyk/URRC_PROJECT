<?xml version="1.0"?>
<sdf version="1.9">
  <model name="team01_car" canonical_link="chassis">
    <self_collide>false</self_collide>

    <!-- Maximum steering envelope: about 0.421 m long, 0.243 m wide, 0.12 m high. -->
    <link name="chassis">
      <pose>0 0 0.045 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia><ixx>0.0061</ixx><iyy>0.0302</iyy><izz>0.0354</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.42 0.18 0.07</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.42 0.18 0.07</size></box></geometry>
        <material><ambient>0.04 0.15 0.55 1</ambient><diffuse>0.05 0.25 0.85 1</diffuse></material>
      </visual>
    </link>

    <link name="team01_lidar_link">
      <pose>0.195 0 0.065 0 0 0</pose>
      <inertial><mass>0.03</mass><inertia><ixx>0.000003</ixx><iyy>0.000003</iyy><izz>0.000006</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.015</radius><length>0.03</length></cylinder></geometry></collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.015</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="front_lidar" type="gpu_lidar">
        <topic>/team01/lidar</topic>
        <update_rate>20</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan><horizontal><samples>721</samples><resolution>1</resolution><min_angle>-1.57079632679</min_angle><max_angle>1.57079632679</max_angle></horizontal></scan>
          <range><min>0.04</min><max>6.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.002</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_fixed_joint" type="fixed"><parent>chassis</parent><child>team01_lidar_link</child></joint>

    <!-- Small steering carriers keep steering and wheel rotation as separate axes. -->
    <link name="front_left_carrier">
      <pose>0.17 0.09 0 0 0 0</pose>
      <inertial><mass>0.02</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia></inertial>
    </link>
    <link name="front_right_carrier">
      <pose>0.17 -0.09 0 0 0 0</pose>
      <inertial><mass>0.02</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia></inertial>
    </link>

    <link name="front_left_wheel">
      <pose>0.17 0.09 0 1.57079632679 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>0.000064</ixx><iyy>0.000032</iyy><izz>0.000032</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>0.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link>
    <link name="front_right_wheel">
      <pose>0.17 -0.09 0 1.57079632679 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>0.000064</ixx><iyy>0.000032</iyy><izz>0.000032</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>0.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link>
    <link name="rear_left_wheel">
      <pose>-0.17 0.09 0 1.57079632679 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>0.000064</ixx><iyy>0.000032</iyy><izz>0.000032</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>0.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link>
    <link name="rear_right_wheel">
      <pose>-0.17 -0.09 0 1.57079632679 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>0.000064</ixx><iyy>0.000032</iyy><izz>0.000032</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>0.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link>

    <joint name="front_left_steering_joint" type="revolute">
      <parent>chassis</parent><child>front_left_carrier</child>
      <axis><xyz expressed_in="__model__">0 0 1</xyz><limit><lower>-0.55</lower><upper>0.55</upper><effort>20</effort><velocity>3</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis>
    </joint>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>chassis</parent><child>front_right_carrier</child>
      <axis><xyz expressed_in="__model__">0 0 1</xyz><limit><lower>-0.55</lower><upper>0.55</upper><effort>20</effort><velocity>3</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis>
    </joint>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_carrier</parent><child>front_left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>20</effort><velocity>100</velocity></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_carrier</parent><child>front_right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>20</effort><velocity>100</velocity></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>20</effort><velocity>100</velocity></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>20</effort><velocity>100</velocity></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rear_left_wheel_joint</joint_name><topic>/team01/actuator/rear_left_velocity</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rear_right_wheel_joint</joint_name><topic>/team01/actuator/rear_right_velocity</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>front_left_steering_joint</joint_name><topic>/team01/actuator/front_left_position</topic><p_gain>8</p_gain><i_gain>0</i_gain><d_gain>0.3</d_gain><cmd_max>20</cmd_max><cmd_min>-20</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>front_right_steering_joint</joint_name><topic>/team01/actuator/front_right_position</topic><p_gain>8</p_gain><i_gain>0</i_gain><d_gain>0.3</d_gain><cmd_max>20</cmd_max><cmd_min>-20</cmd_min>
    </plugin>
  </model>
</sdf>
